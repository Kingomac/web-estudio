---
import type { Catalog } from '../../lib/catalogo.ts';
import type { Subject } from '../../schemas/content.ts';
import { resourceUrl } from '../../lib/sitio.ts';
// Resource tags. With `linkTo`, each tag links to the filtered subject page.
interface Props { tagIds: string[]; catalog: Catalog; linkTo?: Subject; label?: string }
const { tagIds, catalog, linkTo, label = 'Etiquetas' } = Astro.props;
const tags = tagIds.map(id => catalog.byId.get(id)).filter(tag => tag?.kind === 'tag');
---
{tags.length > 0 && <ul class="tag-list" aria-label={label}>{tags.map(tag => <li>{linkTo ? <a class="tag" href={`${resourceUrl(linkTo, catalog)}?tag=${tag.slug}`}>{tag.title}</a> : <span class="tag">{tag.title}</span>}</li>)}</ul>}
