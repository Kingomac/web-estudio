---
import type { Catalog } from '../../lib/catalogo.ts';
// Resource tags. With `linkTo`, each tag links to the filtered resource section.
interface Props { tagIds: string[]; catalog: Catalog; linkTo?: string; label?: string }
const { tagIds, catalog, linkTo, label = 'Etiquetas' } = Astro.props;
const tags = tagIds.map(id => catalog.byId.get(id)).filter(tag => tag?.kind === 'tag');
---
{tags.length > 0 && <ul class="tag-list" aria-label={label}>{tags.map(tag => <li>{linkTo ? <a class="tag" href={`${linkTo}?tag=${tag.slug}`}>{tag.title}</a> : <span class="tag">{tag.title}</span>}</li>)}</ul>}
