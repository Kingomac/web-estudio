---
import { createHash } from 'node:crypto';
import type { Exercise } from '../schemas/content.ts';
import type { Catalog } from '../lib/catalogo.ts';
import { jsonForHtml } from '../lib/sitio.ts';
import Sources from './Sources.astro';
import HexDump from './ui/HexDump.astro';
import { formatHints } from '../domain/formatos.ts';
interface Props { entry: Extract<Exercise, { mode: 'form' }>; catalog: Catalog }
const { entry, catalog } = Astro.props;
const revision = createHash('sha256').update(JSON.stringify(entry)).digest('hex').slice(0, 16);
---
<form-exercise data-id={entry.id} data-revision={revision} data-base={import.meta.env.BASE_URL}>
  <script type="application/json" data-payload set:html={jsonForHtml(entry)} />
  <form class="exercise-form panel"><p class="lead">{entry.prompt}</p>
    {entry.path.length > 0 && <ol class="path" aria-label="Trayecto del paquete">{entry.path.map(hop => <li>{hop}</li>)}</ol>}
    {entry.dump && <HexDump bytes={entry.dump} />}
    {entry.fields.map(field => <div class="field"><label class="field-label" for={`campo-${field.id}`}>{field.label}{field.type === 'number' && <span class="field-hint"> ({field.unit})</span>}</label>{field.type === 'format' && <p class="meta format-hint" id={`ayuda-${field.id}`}>{formatHints[field.format]}</p>}{field.type === 'select' ? <select class="input" id={`campo-${field.id}`} name={field.id} disabled><option value="">Selecciona una opción</option>{field.options.map(o => <option value={o.id}>{o.text}</option>)}</select> : <input class:list={['input', { mono: field.type === 'format' }]} id={`campo-${field.id}`} name={field.id} type="text" inputmode={field.type === 'number' ? 'decimal' : field.type === 'format' && (field.format === 'integer' || field.format === 'bits') ? 'numeric' : 'text'} autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby={field.type === 'format' ? `ayuda-${field.id}` : undefined} disabled />}<p class="status field-feedback" data-field-result={field.id} role="status"></p></div>)}
    <div class="actions no-print"><button type="submit" class="button" disabled>Comprobar ejercicio</button><button type="button" class="button button--secondary" data-reset disabled>Reiniciar ejercicio</button></div>
    <p class="status result" role="status" data-result></p>
    {entry.hint && <details class="hint no-print"><summary>Una pista para avanzar</summary><p>{entry.hint}</p></details>}
    <div data-feedback class="feedback" hidden><p>{entry.explanation}</p>{entry.steps.length > 0 && <ol class="steps">{entry.steps.map(step => <li>{step}</li>)}</ol>}<Sources references={entry.originalReferences} external={entry.externalReferences} catalog={catalog} prominent /></div>
  </form>
  <noscript><p class="callout">Activa JavaScript para introducir y comprobar tus respuestas.</p></noscript>
</form-exercise>
<style>
  form-exercise { display: block; }
  .field-feedback { margin-top: var(--space-2); }
  .format-hint { margin: calc(-1 * var(--space-1)) 0 var(--space-2); font-size: var(--text-xs); }
  .mono { font-family: var(--font-mono); }
  .path { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-4); padding: 0; list-style: none; font-size: var(--text-sm); }
  .path li { padding: 2px var(--space-2); border-radius: var(--radius-sm); background: var(--color-surface-muted); }
  .path li + li::before { content: '→'; margin-right: var(--space-2); color: var(--color-text-muted); }
  .hint { margin-top: var(--space-4); font-size: var(--text-sm); }
  .hint summary { color: var(--color-accent); font-weight: var(--weight-medium); }
  .hint p { margin: var(--space-2) 0 0; }
  .steps { padding-left: var(--space-5); }
  .steps li + li { margin-top: var(--space-1); }
  .result { margin-top: var(--space-4); }
  .feedback { margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--color-border); }
  @media (max-width: 620px) { .exercise-form { padding: var(--space-4); } }
</style>
<script>
  import { gradeField } from '../domain/evaluacion.ts';
  import { storageFor } from '../client/almacenamiento.ts';
  import type { Exercise } from '../schemas/content.ts';
  class FormExercise extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      const entry = JSON.parse(this.querySelector('[data-payload]')!.textContent!) as Extract<Exercise, { mode: 'form' }>;
      const form = this.querySelector('form')!;
      const store = storageFor(entry.id, this.dataset.revision!, this.dataset.base!);
      const controller = new AbortController(); this.cleanup = () => controller.abort();
      const controls = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')];
      this.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>('input, select, button').forEach(el => { el.disabled = false; });
      const raw = store.read();
      if (raw && typeof raw === 'object' && 'answers' in raw && raw.answers && typeof raw.answers === 'object') {
        const answers = raw.answers as Record<string, unknown>;
        controls.forEach(input => { const value = answers[input.name]; if (typeof value === 'string') input.value = value; });
      }
      const mark = (el: Element, text: string, correct?: boolean) => { el.textContent = text; el.classList.toggle('is-correct', correct === true); el.classList.toggle('is-incorrect', correct === false); };
      const clear = () => { this.querySelector<HTMLElement>('[data-feedback]')!.hidden = true; mark(this.querySelector('[data-result]')!, ''); this.querySelectorAll('[data-field-result]').forEach(el => mark(el, '')); };
      const check = () => {
        let correct = true;
        entry.fields.forEach(field => {
          const input = controls.find(c => c.name === field.id)!;
          const result = gradeField(field, input.value);
          correct &&= result.correct;
          const feedback = [...this.querySelectorAll<HTMLElement>('[data-field-result]')].find(el => el.dataset.fieldResult === field.id)!;
          mark(feedback, `${result.correct ? '✓ Correcto.' : 'Revisar.'} ${result.message}`, result.correct);
        });
        mark(this.querySelector('[data-result]')!, correct ? '✓ Ejercicio correcto' : 'Revisa los campos indicados y vuelve a intentarlo.', correct);
        this.querySelector<HTMLElement>('[data-feedback]')!.hidden = false;
      };
      const save = (checked: boolean) => store.write({ answers: Object.fromEntries(controls.map(c => [c.name, c.value])), checked });
      form.addEventListener('input', () => { clear(); save(false); }, { signal: controller.signal });
      form.addEventListener('submit', event => { event.preventDefault(); check(); save(true); }, { signal: controller.signal });
      this.querySelector('[data-reset]')!.addEventListener('click', () => { form.reset(); clear(); store.reset(); }, { signal: controller.signal });
      if (raw && typeof raw === 'object' && 'checked' in raw && raw.checked === true) check();
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('form-exercise', FormExercise);
</script>
