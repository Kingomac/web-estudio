---
import type { Resource } from '../schemas/content.ts';
import type { Catalog } from '../lib/catalogo.ts';
import { labels } from '../lib/rutas.ts';
import { resourceUrl } from '../lib/sitio.ts';
interface Props { entry: Resource; catalog: Catalog }
const { entry, catalog } = Astro.props;
const marks = { apuntes: 'Aa', resumen: '≡', test: '✓', ejercicio: '↔', material: 'PDF' };
---
<article class="resource-card" data-resource data-tags={entry.tagIds.map(t => { const tag = catalog.byId.get(t); return tag?.kind === 'tag' ? tag.slug : ''; }).join(' ')}>
  <div class="card-top"><span class:list={['resource-icon', entry.kind]} aria-hidden="true">{marks[entry.kind]}</span><span class="eyebrow">{labels[entry.kind]}</span>{'printIntent' in entry && entry.printIntent === 'paper' && <span class="paper-badge">Para imprimir</span>}</div>
  <h3><a href={resourceUrl(entry, catalog)}>{entry.title}<span class="card-arrow" aria-hidden="true">↗</span></a></h3>
  <p>{entry.description}</p>
  <p class="card-scope"><strong>Alcance</strong> {entry.scope}</p>
  <div class="tags">{entry.tagIds.map(t => { const tag = catalog.byId.get(t); return <span>{tag?.kind === 'tag' ? tag.title : t}</span>; })}</div>
</article>
