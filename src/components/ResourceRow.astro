---
import type { Resource } from '../schemas/content.ts';
import type { Catalog } from '../lib/catalogo.ts';
import { labels } from '../lib/rutas.ts';
import { resourceUrl } from '../lib/sitio.ts';
interface Props { entry: Resource; catalog: Catalog }
const { entry, catalog } = Astro.props;
---
<article class="resource-row" data-resource data-tags={entry.tagIds.map(t => { const tag = catalog.byId.get(t); return tag?.kind === 'tag' ? tag.slug : ''; }).join(' ')}>
  <div class="resource-kind"><span>{labels[entry.kind]}</span>{'printIntent' in entry && entry.printIntent === 'paper' && <span class="muted">Imprimible</span>}</div>
  <div class="resource-description"><h2><a href={resourceUrl(entry, catalog)}>{entry.title}</a></h2><p>{entry.description}</p></div>
  <ul class="resource-topics" aria-label="Etiquetas">{entry.tagIds.map(id => { const tag = catalog.byId.get(id); return tag?.kind === 'tag' && <li>{tag.title}</li>; })}</ul>
</article>
