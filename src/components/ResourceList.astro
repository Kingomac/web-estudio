---
import ResourceRow from './ResourceRow.astro';
import type { Resource, Tag } from '../schemas/content.ts';
import type { Catalog } from '../lib/catalogo.ts';
interface Props { entries: Resource[]; tags: Tag[]; catalog: Catalog }
const { entries, tags, catalog } = Astro.props;
---
<resource-list>
  {tags.length > 0 && <div class="chip-group no-print" role="group" aria-label="Filtrar por tema o preparación">
    <button type="button" class="chip" data-tag="" aria-pressed="true">Todos</button>
    {tags.map(tag => <button type="button" class="chip" data-tag={tag.slug} aria-pressed="false">{tag.title}</button>)}
  </div>}
  <p class="meta count" role="status">{entries.length} {entries.length === 1 ? 'recurso' : 'recursos'}</p>
  <div class="row-list">{entries.map(entry => <ResourceRow entry={entry} catalog={catalog} />)}</div>
  <p class="empty-state" data-empty hidden={entries.length > 0}>{entries.length ? 'No hay recursos con esta etiqueta.' : 'Todavía no hay recursos en esta sección.'}</p>
  <noscript><p class="meta">Se muestran todos los recursos. Activa JavaScript para filtrar por etiqueta.</p></noscript>
</resource-list>
<style>
  resource-list { display: block; }
  .count { margin: var(--space-4) 0 var(--space-2); }
  .row-list:empty { display: none; }
</style>
<script>
  class ResourceList extends HTMLElement {
    connectedCallback() {
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-tag]')];
      const apply = (tag: string, updateUrl = false) => {
        if (!buttons.some(b => b.dataset.tag === tag)) tag = '';
        let count = 0;
        this.querySelectorAll<HTMLElement>('[data-resource]').forEach(card => {
          card.hidden = !!tag && !(card.dataset.tags || '').split(' ').includes(tag);
          if (!card.hidden) count++;
        });
        buttons.forEach(b => { const active = b.dataset.tag === tag; b.setAttribute('aria-pressed', String(active)); });
        this.querySelector<HTMLElement>('[data-empty]')!.hidden = count > 0;
        this.querySelector<HTMLElement>('[role="status"]')!.textContent = `${count} ${count === 1 ? 'recurso' : 'recursos'}`;
        if (updateUrl) { const url = new URL(location.href); tag ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag'); history.pushState(null, '', url); }
      };
      const abort = new AbortController();
      this.cleanup = () => abort.abort();
      buttons.forEach(b => b.addEventListener('click', () => apply(b.dataset.tag || '', true), { signal: abort.signal }));
      window.addEventListener('popstate', () => apply(new URL(location.href).searchParams.get('tag') || ''), { signal: abort.signal });
      apply(new URL(location.href).searchParams.get('tag') || '');
    }
    cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('resource-list', ResourceList);
</script>
