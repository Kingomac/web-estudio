---
// Static SVG figures of the beginner's reading on topic 6. Each one has a caption that explains it in words (also on paper).
interface Props {
  figura: 'enlace' | 'decibelios' | 'circuito' | 'plano-z' | 'cadena' | 'isotropica' | 'esfera' | 'angulos' | 'lobulos' | 'dipolo' | 'polarizacion' | 'plf' | 'area' | 'balance';
}
const { figura } = Astro.props;
const fid = `fig-radio-${figura}`;
const arrow = `${fid}-flecha`;
const pt = (x: number, y: number) => `${x.toFixed(1)} ${y.toFixed(1)}`;

// Polar outline of a pattern with the main direction upwards; r(α) in pixels.
const polar = (cx: number, cy: number, r: (a: number) => number, step = 0.5) =>
  `M ${Array.from({ length: Math.round(360 / step) + 1 }, (_, i) => { const a = (-180 + i * step) * Math.PI / 180; return pt(cx + r(a) * Math.sin(a), cy - r(a) * Math.cos(a)); }).join(' L ')} Z`;

// Lobes figure: four-element array (λ/2 spacing) with a mild element pattern, drawn in dB from 0 to −30 dB.
const L = { cx: 200, cy: 180, R: 140 };
const arrayPower = (a: number) => {
  const u = (Math.PI / 2) * Math.sin(a);
  const af = Math.abs(Math.sin(u)) < 1e-9 ? 1 : Math.sin(4 * u) / (4 * Math.sin(u));
  return (af * (1 + 0.6 * Math.cos(a)) / 1.6) ** 2;
};
const dbRadius = (p: number) => L.R * Math.max(0, (10 * Math.log10(Math.max(p, 1e-6)) + 30) / 30);
let hpHalf = 0;
for (let a = 0; a < Math.PI / 2; a += 1e-4) if (arrayPower(a) <= 0.5) { hpHalf = a; break; }
const lobeShape = polar(L.cx, L.cy, a => dbRadius(arrayPower(a)), 0.25);
const ray = (a: number, r: number) => pt(L.cx + r * Math.sin(a), L.cy - r * Math.cos(a));
const hpbwDeg = Math.round(2 * hpHalf * 180 / Math.PI);
const r3 = dbRadius(0.5);

// Dipole: sen²θ cut with the wire vertical.
const dipoleShape = polar(100, 110, a => 85 * Math.sin(a) ** 2);

// Link budget example of the reading: PIRE 20 dBm, Gr 2 dBi, Lbf 80 dB.
const yDb = (db: number) => 60 + (25 - db) * 3;
// dB ruler.
const ruler = [[30, '1 W'], [20, '100 mW'], [10, '10 mW'], [0, '1 mW'], [-10, '100 µW'], [-20, '10 µW'], [-30, '1 µW']] as const;
const yRuler = (db: number) => 25 + (30 - db) * 5;
const num = (n: number) => n.toLocaleString('es-ES').replace('-', '−');
---
<figure class="radio-fig panel panel--muted" id={fid}>
  {figura === 'enlace' && (
    <svg class="radio-svg" viewBox="0 0 400 130" role="img" aria-labelledby={`${fid}-cap`}>
      <defs><marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="f-head" d="M 0 0 L 10 5 L 0 10 Z" /></marker></defs>
      <rect class="f-box" x="6" y="60" width="62" height="40" rx="6" /><text x="37" y="87">TX</text>
      <path class="f-wire" d="M 68 80 H 116 V 34 M 100 14 L 116 34 L 132 14" />
      {[152, 187, 222, 257].map(x => <path class="f-wave" d={`M ${x} 8 Q ${x + 16} 34 ${x} 60`} />)}
      <path class="f-wire" d="M 284 34 V 80 H 332 M 268 14 L 284 34 L 300 14" />
      <rect class="f-box" x="332" y="60" width="62" height="40" rx="6" /><text x="363" y="87">RX</text>
      <path class="f-dim" d="M 134 118 H 266" marker-start={`url(#${arrow})`} marker-end={`url(#${arrow})`} />
      <text class="f-muted" x="200" y="108">distancia r</text>
      {[[90, 80], [116, 57], [160, 34], [230, 34], [284, 57], [310, 80]].map(([x, y], i) => <g><circle class="f-badge" cx={x} cy={y} r="12" /><text class="f-badge-n" x={x} y={y! + 6}>{i + 1}</text></g>)}
    </svg>
  )}
  {figura === 'decibelios' && (
    <svg class="radio-svg" viewBox="0 0 400 345" role="img" aria-labelledby={`${fid}-cap`}>
      <defs><marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="f-head" d="M 0 0 L 10 5 L 0 10 Z" /></marker></defs>
      <path class="f-axis" d={`M 150 ${yRuler(30) - 10} V ${yRuler(-30) + 10}`} />
      {ruler.map(([db, w]) => <g>
        <path class="f-axis" d={`M 142 ${yRuler(db)} H 158`} />
        <text class:list={[{ 'f-strong': db === 0 }]} x="134" y={yRuler(db) + 6} text-anchor="end">{`${db > 0 ? '+' : ''}${num(db)} dBm`}</text>
        <text class:list={[{ 'f-strong': db === 0 }]} x="168" y={yRuler(db) + 6} text-anchor="start">{w}</text>
      </g>)}
      <path class="f-accent-line" d={`M 245 ${yRuler(0)} Q 270 ${yRuler(5)} 245 ${yRuler(10)}`} marker-end={`url(#${arrow})`} />
      <text class="f-accent" x="272" y={yRuler(5) + 6} text-anchor="start">×10: +10 dB</text>
      <path class="f-accent-line" d={`M 245 ${yRuler(-10)} Q 270 ${yRuler(-20)} 245 ${yRuler(-30)}`} marker-end={`url(#${arrow})`} />
      <text class="f-accent" x="272" y={yRuler(-20) + 6} text-anchor="start">÷100: −20 dB</text>
    </svg>
  )}
  {figura === 'circuito' && (
    <svg class="radio-svg" viewBox="0 0 400 215" role="img" aria-labelledby={`${fid}-cap`}>
      <rect class="f-zone" x="150" y="8" width="244" height="180" rx="8" />
      <path class="f-wire" d="M 30 92 V 40 H 62 M 112 40 H 165 M 207 40 H 227 M 272 40 H 292 M 337 40 H 380 V 170 H 30 V 128" />
      <circle class="f-box" cx="30" cy="110" r="18" /><text x="30" y="117">vg</text>
      <rect class="f-box" x="62" y="30" width="50" height="20" rx="3" /><text class="f-strong" x="87" y="22">ZG</text>
      <rect class="f-box" x="165" y="30" width="42" height="20" rx="3" /><text class="f-strong" x="186" y="22">RΩ</text>
      <rect class="f-box" x="227" y="30" width="45" height="20" rx="3" /><text class="f-strong" x="250" y="22">Rrad</text>
      <path class="f-wire" d="M 292 40 a 7.5 7.5 0 0 1 15 0 a 7.5 7.5 0 0 1 15 0 a 7.5 7.5 0 0 1 15 0" /><text class="f-strong" x="314" y="22">jXA</text>
      <text class="f-muted" x="186" y="80">calor</text>
      <text class="f-muted" x="250" y="80">radia</text>
      <text class="f-muted" x="317" y="80">guarda</text>
      <text class="f-accent" x="272" y="132">ZA = RΩ + Rrad + jXA</text>
      <text class="f-muted" x="88" y="150">transmisor</text>
      <text class="f-muted" x="272" y="208">antena</text>
    </svg>
  )}
  {figura === 'plano-z' && (
    <svg class="radio-svg" viewBox="0 0 400 260" role="img" aria-labelledby={`${fid}-cap`}>
      <defs><marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="f-head" d="M 0 0 L 10 5 L 0 10 Z" /></marker></defs>
      <path class="f-axis" d="M 60 200 H 385" marker-end={`url(#${arrow})`} />
      <path class="f-axis" d="M 60 236 V 18" marker-end={`url(#${arrow})`} />
      <path class="f-guide" d="M 180 80 V 200 M 180 80 H 60" />
      <path class="f-accent-line f-thick" d="M 60 200 L 176 84" marker-end={`url(#${arrow})`} />
      <circle class="f-badge" cx="235" cy="200" r="6" />
      <text class="f-muted" x="385" y="226" text-anchor="end">R</text>
      <text class="f-muted" x="72" y="24" text-anchor="start">jX</text>
      <text class="f-accent" x="190" y="74" text-anchor="start">ZA = 50 + j50 Ω</text>
      <text x="120" y="224">50 Ω</text>
      <text x="52" y="146" text-anchor="end">50</text>
      <text x="235" y="226">73 Ω</text>
      <text class="f-muted" x="235" y="252">resonante (X = 0)</text>
    </svg>
  )}
  {figura === 'cadena' && (
    <svg class="radio-svg" viewBox="0 0 400 285" role="img" aria-labelledby={`${fid}-cap`}>
      <text x="20" y="22" text-anchor="start"><tspan class="f-strong">pt</tspan> · disponible en el transmisor</text>
      <rect class="f-seg1" x="20" y="30" width="280" height="30" rx="3" /><text x="308" y="52" text-anchor="start">1 W</text>
      <text class="f-muted" x="20" y="88" text-anchor="start">↓ rebota el 11 % (VSWR = 2)</text>
      <text x="20" y="112" text-anchor="start"><tspan class="f-strong">pat</tspan> · entregada a la antena</text>
      <rect class="f-seg1" x="20" y="120" width="248.9" height="30" rx="3" /><rect class="f-lost" x="268.9" y="120" width="31.1" height="30" rx="3" /><text x="308" y="142" text-anchor="start">0,889 W</text>
      <text class="f-muted" x="20" y="178" text-anchor="start">↓ el 20 % se va en calor (η = 80 %)</text>
      <text x="20" y="202" text-anchor="start"><tspan class="f-strong">prad</tspan> · radiada al aire</text>
      <rect class="f-seg1" x="20" y="210" width="199.1" height="30" rx="3" /><rect class="f-lost" x="219.1" y="210" width="49.8" height="30" rx="3" /><text x="308" y="232" text-anchor="start">0,711 W</text>
      <text class="f-muted" x="20" y="274" text-anchor="start">En dB: −0,51 dB y luego −0,97 dB</text>
    </svg>
  )}
  {figura === 'isotropica' && (
    <svg class="radio-svg" viewBox="0 0 400 220" role="img" aria-labelledby={`${fid}-cap`}>
      <defs><marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="f-head" d="M 0 0 L 10 5 L 0 10 Z" /></marker></defs>
      <circle class="f-shape" cx="90" cy="100" r="30" />
      {Array.from({ length: 8 }, (_, i) => { const a = i * Math.PI / 4; return <path class="f-ray" d={`M ${pt(90 + 34 * Math.cos(a), 100 + 34 * Math.sin(a))} L ${pt(90 + 56 * Math.cos(a), 100 + 56 * Math.sin(a))}`} marker-end={`url(#${arrow})`} />; })}
      <circle class="f-source" cx="90" cy="100" r="5" />
      <text class="f-muted" x="90" y="178">d = 1</text>
      <circle class="f-shape" cx="310" cy="100" r="60" />
      <circle class="f-ref" cx="250" cy="100" r="30" />
      <circle class="f-source" cx="250" cy="100" r="5" />
      <path class="f-ray" d="M 316 100 H 384" marker-end={`url(#${arrow})`} />
      <text class="f-strong" x="310" y="30">d = 4 (+6 dB)</text>
      <text class="f-muted" x="214" y="150" text-anchor="end">d = 0</text>
      <text class="f-muted" x="258" y="62" text-anchor="end">d = 1</text>
      <text class="f-strong" x="90" y="200">Isotrópica</text>
      <text class="f-strong" x="290" y="200">Directiva</text>
    </svg>
  )}
  {figura === 'esfera' && (
    <svg class="radio-svg" viewBox="0 0 400 280" role="img" aria-labelledby={`${fid}-cap`}>
      <path class="f-cone" d="M 30 110 L 310 70 L 310 150 Z" />
      <path class="f-axis" d="M 30 110 L 310 70 M 30 110 L 310 150" />
      <path class="f-accent-line f-thick" d="M 170 90 V 130 M 310 70 V 150" />
      <circle class="f-source" cx="30" cy="110" r="6" />
      <text x="170" y="80">r</text><text x="310" y="60">2r</text>
      <path class="f-guide" d="M 170 130 V 186 M 310 150 V 176" />
      <text class="f-muted" x="20" y="214" text-anchor="start">de frente:</text>
      <rect class="f-seg1" x="150" y="190" width="40" height="40" /><text class="f-on" x="170" y="216">s</text>
      <rect class="f-shape" x="270" y="180" width="80" height="80" />
      <path class="f-axis" d="M 310 180 V 260 M 270 220 H 350" />
      <rect class="f-seg1" x="270" y="180" width="40" height="40" /><text class="f-on f-small" x="290" y="206">s/4</text>
    </svg>
  )}
  {figura === 'angulos' && (
    <svg class="radio-svg" viewBox="0 0 400 300" role="img" aria-labelledby={`${fid}-cap`}>
      <defs><marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="f-head" d="M 0 0 L 10 5 L 0 10 Z" /></marker></defs>
      <path class="f-plane" d="M 80 268 L 290 268 L 380 190 L 170 190 Z" />
      <path class="f-axis" d="M 170 190 V 30" marker-end={`url(#${arrow})`} />
      <path class="f-axis" d="M 170 190 L 82 266" marker-end={`url(#${arrow})`} />
      <path class="f-axis" d="M 170 190 H 380" marker-end={`url(#${arrow})`} />
      <path class="f-guide" d="M 275 85 V 235 M 170 190 L 275 235" />
      <path class="f-accent-line f-thick" d="M 170 190 L 272 88" marker-end={`url(#${arrow})`} />
      <path class="f-arc" d="M 170 135 A 55 55 0 0 1 208.9 151.1" />
      <path class="f-arc2" d="M 136 219.5 A 45 45 0 0 0 211.4 207.7" />
      <text class="f-accent" x="199" y="128">θ</text>
      <text class="f-seg2-t" x="180" y="262">φ</text>
      <text x="180" y="30" text-anchor="start">+z (θ = 0°)</text>
      <text x="72" y="292">x</text><text x="384" y="214">y</text>
      <text class="f-accent" x="286" y="80" text-anchor="start">(θ, φ)</text>
      <text class="f-muted" x="395" y="290" text-anchor="end">plano xy: θ = 90°</text>
    </svg>
  )}
  {figura === 'lobulos' && (
    <svg class="radio-svg" viewBox="0 0 400 340" role="img" aria-labelledby={`${fid}-cap`}>
      {[1, 2 / 3, 1 / 3].map(f => <circle class="f-grid" cx={L.cx} cy={L.cy} r={L.R * f} />)}
      <circle class="f-ref" cx={L.cx} cy={L.cy} r={r3} />
      <path class="f-grid" d={`M ${L.cx} ${L.cy - L.R} V ${L.cy + L.R} M ${L.cx - L.R} ${L.cy} H ${L.cx + L.R}`} />
      <path class="f-shape f-shape-strong" d={lobeShape} />
      <path class="f-beam" d={`M ${L.cx} ${L.cy} L ${ray(-Math.PI / 6, L.R + 6)} M ${L.cx} ${L.cy} L ${ray(Math.PI / 6, L.R + 6)}`} />
      <path class="f-arc2" d={`M ${ray(-hpHalf, r3)} A ${r3} ${r3} 0 0 1 ${ray(hpHalf, r3)}`} />
      <text class="f-strong" x={L.cx} y="22">lóbulo principal</text>
      <text class="f-seg2-t" x="258" y="100" text-anchor="start">{`HPBW ≈ ${hpbwDeg}°`}</text>
      <text class="f-muted" x="118" y="56" text-anchor="end">FNBW 60°</text>
      <text x="292" y="150" text-anchor="start">lóbulo</text><text x="292" y="172" text-anchor="start">lateral</text>
      <text x={L.cx} y="290">lóbulo trasero</text>
      {[[0, '0 dB'], [1, '−10']].map(([k, t]) => <text class="f-muted" x={L.cx - L.R + (Number(k) * L.R) / 3 + 4} y={L.cy - 6} text-anchor="start">{t}</text>)}
      <text class="f-muted" x={L.cx + r3 - 4} y={L.cy + 24} text-anchor="end">−3 dB</text>
    </svg>
  )}
  {figura === 'dipolo' && (
    <svg class="radio-svg" viewBox="0 0 400 230" role="img" aria-labelledby={`${fid}-cap`}>
      <path class="f-shape f-shape-strong" d={dipoleShape} />
      <path class="f-wire f-thick" d="M 100 55 V 165" />
      <text class="f-muted" x="100" y="38">nada en el eje</text>
      <circle class="f-shape f-shape-strong" cx="300" cy="110" r="85" />
      <circle class="f-source" cx="300" cy="110" r="7" />
      <text class="f-strong" x="100" y="220">De lado</text>
      <text class="f-strong" x="300" y="220">Desde arriba</text>
    </svg>
  )}
  {figura === 'polarizacion' && (
    <svg class="radio-svg" viewBox="0 0 400 210" role="img" aria-labelledby={`${fid}-cap`}>
      <defs><marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="f-head" d="M 0 0 L 10 5 L 0 10 Z" /></marker></defs>
      <path class="f-accent-line f-thick" d="M 67 42 V 148" marker-start={`url(#${arrow})`} marker-end={`url(#${arrow})`} />
      <circle class="f-ref" cx="200" cy="95" r="52" />
      <path class="f-accent-line f-thick" d="M 252 95 A 52 52 0 0 1 163.2 131.8" marker-end={`url(#${arrow})`} />
      <path class="f-axis" d="M 200 95 L 236.8 58.2" marker-end={`url(#${arrow})`} />
      <ellipse class="f-ref" cx="333" cy="95" rx="58" ry="30" transform="rotate(-30 333 95)" />
      <path class="f-accent-line f-thick" d="M 383.2 66 A 58 30 -30 0 1 318 136" marker-end={`url(#${arrow})`} />
      <text class="f-muted" x="222" y="98" text-anchor="start">E</text>
      <text class="f-strong" x="67" y="195">Lineal</text>
      <text class="f-strong" x="200" y="195">Circular</text>
      <text class="f-strong" x="333" y="195">Elíptica</text>
    </svg>
  )}
  {figura === 'plf' && (
    <svg class="radio-svg" viewBox="0 0 400 240" role="img" aria-labelledby={`${fid}-cap`}>
      <defs><marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="f-head" d="M 0 0 L 10 5 L 0 10 Z" /></marker></defs>
      <path class="f-wire f-rod" d="M 131 177.9 L 269 62.1" />
      <path class="f-accent-line f-thick" d="M 200 210 V 34" marker-end={`url(#${arrow})`} />
      <path class="f-guide" d="M 200 30 L 244.3 82.8" />
      <path class="f-seg2-line" d="M 200 120 L 244.3 82.8" />
      <path class="f-arc" d="M 200 80 A 40 40 0 0 1 230.6 94.3" />
      <text class="f-accent" x="192" y="44" text-anchor="end">E de la onda</text>
      <text x="278" y="62" text-anchor="start">antena</text>
      <text class="f-accent" x="210" y="74" text-anchor="start">α</text>
      <text class="f-seg2-t" x="252" y="100" text-anchor="start">E · cos α</text>
      <text x="200" y="234">potencia captada × cos² α</text>
    </svg>
  )}
  {figura === 'area' && (
    <svg class="radio-svg" viewBox="0 0 400 225" role="img" aria-labelledby={`${fid}-cap`}>
      <defs><marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="f-head" d="M 0 0 L 10 5 L 0 10 Z" /></marker></defs>
      {[30, 70, 100, 130, 170].map(y => (y >= 70 && y <= 130)
        ? <path class="f-accent-line" d={`M 20 ${y} H 226`} marker-end={`url(#${arrow})`} />
        : <path class="f-ray" d={`M 20 ${y} H 370`} marker-end={`url(#${arrow})`} />)}
      <rect class="f-net" x="230" y="55" width="18" height="90" rx="4" />
      <path class="f-wire" d="M 248 100 H 300" /><rect class="f-box" x="300" y="84" width="54" height="32" rx="6" /><text x="327" y="106">RX</text>
      <text class="f-muted" x="20" y="18" text-anchor="start">densidad s (W/m²)</text>
      <text class="f-accent" x="239" y="52">Aeq</text>
      <text x="200" y="212">par = s · Aeq · plf</text>
    </svg>
  )}
  {figura === 'balance' && (
    <svg class="radio-svg" viewBox="0 0 400 345" role="img" aria-labelledby={`${fid}-cap`}>
      {[20, 0, -20, -40, -60].map(db => <g><path class:list={[db === 0 ? 'f-axis' : 'f-grid']} d={`M 60 ${yDb(db)} H 395`} /><text class="f-muted" x="52" y={yDb(db) + 6} text-anchor="end">{num(db)}</text></g>)}
      <text class="f-muted" x="52" y="34" text-anchor="end">dBm</text>
      {['PIRE', '+ Gr', '− Lbf', 'Pr'].map((t, i) => <text class="f-strong" x={105 + 80 * i} y="34">{t}</text>)}
      <rect class="f-seg1" x="73" y={yDb(20)} width="64" height={yDb(0) - yDb(20)} />
      <text x="105" y={yDb(20) - 8}>20</text>
      <rect class="f-seg5" x="153" y={yDb(22)} width="64" height={yDb(20) - yDb(22)} />
      <text x="185" y={yDb(22) - 8}>+2</text>
      <rect class="f-seg2" x="233" y={yDb(22)} width="64" height={yDb(-58) - yDb(22)} />
      <text class="f-on" x="265" y={yDb(-18) + 6}>−80</text>
      <rect class="f-seg3" x="313" y={yDb(0)} width="64" height={yDb(-58) - yDb(0)} />
      <text class="f-strong" x="345" y={yDb(-58) + 24}>−58 dBm</text>
      <path class="f-guide" d={`M 137 ${yDb(20)} H 153 M 217 ${yDb(22)} H 233 M 297 ${yDb(-58)} H 313`} />
    </svg>
  )}
  <figcaption id={`${fid}-cap`}><slot /></figcaption>
</figure>
<style>
  .radio-fig { margin: var(--space-5) 0; padding: var(--space-4); }
  .radio-svg { display: block; width: 100%; max-width: 30rem; height: auto; margin: 0 auto var(--space-3); font-family: var(--font-sans); font-size: var(--text-lg); }
  .radio-fig figcaption { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--leading); }
  .radio-fig figcaption :global(strong) { color: var(--color-text); }
  .radio-svg text { fill: var(--color-text); text-anchor: middle; }
