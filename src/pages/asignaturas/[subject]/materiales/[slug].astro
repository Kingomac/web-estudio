---
import { stat } from 'node:fs/promises';
import Resource from '../../../../layouts/Resource.astro';
import Relations from '../../../../components/Relations.astro';
import { resourcePaths } from '../../../../lib/paths.ts';
import { siteCatalog, url } from '../../../../lib/sitio.ts';
import type { Material } from '../../../../schemas/content.ts';
export async function getStaticPaths() { return resourcePaths('material'); }
interface Props { entry: Material }
const { entry } = Astro.props;
const catalog = await siteCatalog();
const size = (await stat(`public/${entry.file}`)).size;
---
<Resource entry={entry}><section class="material-panel"><div><p class="eyebrow">Documento PDF</p><h2>{entry.providedName}</h2><dl class="material-details"><div><dt>Extensión</dt><dd>{entry.pageCount} páginas</dd></div><div><dt>Tamaño</dt><dd>{(size / 1024 / 1024).toLocaleString('es', { maximumFractionDigits: 1 })} MB</dd></div><div><dt>Procedencia</dt><dd>{entry.origin.label}</dd></div></dl><div class="answer-actions"><a class="button" href={url(entry.file)} target="_blank" rel="noopener">Abrir PDF <span class="external-note">(nueva pestaña)</span> ↗</a><a class="button secondary" href={url(entry.file)} download={entry.providedName}>Descargar original ↓</a></div></div></section><Relations resource={entry} catalog={catalog} /></Resource>
