---
import Resource from '../../../../layouts/Resource.astro';
import FormExercise from '../../../../components/FormExercise.astro';
import { workshopModules } from '../../../../lib/talleres.ts';
import Sources from '../../../../components/Sources.astro';
import Relations from '../../../../components/Relations.astro';
import { resourcePaths } from '../../../../lib/paths.ts';
import { siteCatalog } from '../../../../lib/sitio.ts';
import type { Exercise } from '../../../../schemas/content.ts';
export async function getStaticPaths() { return resourcePaths('ejercicio'); }
interface Props { entry: Exercise }
const { entry } = Astro.props;
const catalog = await siteCatalog();
const Workshop = entry.mode === 'workshop' ? (await workshopModules[entry.workshopId]()).default : undefined;
---
<Resource entry={entry}>{entry.mode === 'form' ? <FormExercise entry={entry} catalog={catalog} /> : Workshop && <><p class="lead">{entry.prompt}</p><Workshop id="taller-ndp" /><Sources references={entry.sources} catalog={catalog} /></>}<Relations resource={entry} catalog={catalog} /></Resource>
