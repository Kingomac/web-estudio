---
import Site from '../layouts/Site.astro';
import SubjectRow from '../components/SubjectRow.astro';
import { siteCatalog, resourceUrl } from '../lib/sitio.ts';
import { isResource } from '../lib/catalogo.ts';
const catalog = await siteCatalog();
const subjects = catalog.entries.filter(e => e.kind === 'asignatura');
const resources = catalog.entries.filter(isResource);
const bimesters = catalog.entries.filter(e => e.kind === 'bimestre');
---
<Site title="Materiales del máster">
  <header class="page-header">
    <p class="eyebrow">Máster en Internet de las Cosas</p>
    <h1>Materiales del máster</h1>
    <p class="page-summary">Curso 2026/27 <span aria-hidden="true">·</span> {subjects.length} {subjects.length === 1 ? 'asignatura' : 'asignaturas'} <span aria-hidden="true">·</span> {resources.length} recursos</p>
  </header>
  <div class="course-index">
    {bimesters.map(b => {
      const entries = subjects.filter(s => s.bimesterId === b.id);
      return <section class:list={['bimester-section', { 'is-empty': entries.length === 0 }]} aria-labelledby={`heading-${b.id}`}>
        <div class="section-heading"><h2 id={`heading-${b.id}`}><a href={resourceUrl(b, catalog)}>{b.title}</a></h2><span class="muted">{entries.length ? `${entries.length} ${entries.length === 1 ? 'asignatura' : 'asignaturas'}` : 'Sin materiales incorporados'}</span></div>
        {entries.map(entry => <SubjectRow entry={entry} catalog={catalog} heading="h3" />)}
      </section>;
    })}
  </div>
</Site>
