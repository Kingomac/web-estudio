---
import Site from './Site.astro';
import { siteCatalog, url, resourceUrl } from '../lib/sitio.ts';
import { labels, sections } from '../lib/rutas.ts';
import type { Resource } from '../schemas/content.ts';
interface Props { entry: Resource }
const { entry } = Astro.props;
const catalog = await siteCatalog();
const subject = catalog.byId.get(entry.subjectId);
if (subject?.kind !== 'asignatura') throw new Error('Asignatura inexistente.');
---
<Site title={entry.title} description={entry.description} subject={subject}>
  <header class:list={['resource-header', { 'reading-header': entry.kind === 'apuntes' || entry.kind === 'resumen' }]}><a class="section-back" href={url(`/asignaturas/${subject.slug}/${sections[entry.kind]}/`)}>← {labels[entry.kind]}</a><h1>{entry.title}</h1><p class="scope"><strong>Alcance:</strong> {entry.scope}</p><div class="tags">{entry.tagIds.map(id => { const tag = catalog.byId.get(id); return tag?.kind === 'tag' && <a href={`${resourceUrl(subject, catalog)}?tag=${tag.slug}`}>{tag.title}</a>; })}</div></header>
  <slot />
</Site>
