---
import Site from './Site.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import TagList from '../components/ui/TagList.astro';
import { siteCatalog, url } from '../lib/sitio.ts';
import { labels, sections } from '../lib/rutas.ts';
import type { Resource } from '../schemas/content.ts';
interface Props { entry: Resource }
const { entry } = Astro.props;
const catalog = await siteCatalog();
const subject = catalog.byId.get(entry.subjectId);
if (subject?.kind !== 'asignatura') throw new Error('Asignatura inexistente.');
---
<Site title={entry.title} description={entry.description} subject={subject} reading={entry.kind === 'apuntes' || entry.kind === 'resumen'}>
  <PageHeader title={entry.title} back={{ href: url(`/asignaturas/${subject.slug}/${sections[entry.kind]}/`), label: labels[entry.kind] }}>
    <p class="scope meta"><strong>Alcance:</strong> {entry.scope}</p>
    <div class="no-print"><TagList tagIds={entry.tagIds} catalog={catalog} linkTo={subject} /></div>
  </PageHeader>
  <slot />
</Site>
<style>
  .scope { max-width: var(--measure); margin-bottom: var(--space-3); }
  .scope strong { color: var(--color-text); font-weight: var(--weight-medium); }
</style>
