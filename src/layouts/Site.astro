---
import '../styles/global.css';
import MenuIcon from '../components/ui/MenuIcon.astro';
import { siteCatalog, url, resourceUrl } from '../lib/sitio.ts';
import { labels, sections } from '../lib/rutas.ts';
import type { Subject } from '../schemas/content.ts';
interface Props { title: string; description?: string; subject?: Subject; reading?: boolean }
const { title, description = 'Materiales de estudio del máster en Internet de las Cosas.', subject, reading = false } = Astro.props;
const catalog = await siteCatalog();
const bimesters = catalog.entries.filter(e => e.kind === 'bimestre');
const subjects = catalog.entries.filter(e => e.kind === 'asignatura');
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f5f4b" />
    <title>{title} · Cuaderno IoT</title>
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body class:list={{ 'site--reading': reading }}>
    <a class="skip-link no-print" href="#contenido">Saltar al contenido</a>
    <aside id="menu-principal" class="sidebar no-print" aria-label="Navegación principal">
      <a class="brand" href={url('/')} aria-label="Cuaderno IoT · Inicio">Cuaderno IoT<span class="brand-sub">MUIoT · Curso 2026/27</span></a>
      <details class="site-navigation" open>
        <summary class="button button--secondary button--small menu-toggle" aria-label="Menú principal" title="Menú principal"><MenuIcon close="cross" /></summary>
        <nav aria-label="Catálogo">
          <a class:list={['nav-link', { 'is-active': current === url('/') }]} href={url('/')} aria-current={current === url('/') ? 'page' : undefined}>Inicio</a>
          {bimesters.map(b => {
            const entries = subjects.filter(s => s.bimesterId === b.id);
            const href = resourceUrl(b, catalog);
            return <div class="nav-group">
              <a class:list={['eyebrow', { 'is-active': current === href }]} href={href} aria-current={current === href ? 'page' : undefined}>{b.title}</a>
              {entries.length === 0 && <p class="nav-empty">Sin asignaturas</p>}
              {entries.map(s => <div class="nav-subject">
                <a class:list={['nav-link', { 'is-active': subject?.id === s.id }]} href={resourceUrl(s, catalog)} aria-current={current === resourceUrl(s, catalog) ? 'page' : undefined}>{s.title}</a>
                {subject?.id === s.id && <ul class="nav-sections">{Object.entries(sections).map(([kind, section]) => {
                  const sectionHref = url(`/asignaturas/${s.slug}/${section}/`);
                  return <li><a class:list={{ 'is-active': current.startsWith(sectionHref) }} href={sectionHref} aria-current={current === sectionHref ? 'page' : current.startsWith(sectionHref) ? 'location' : undefined}>{labels[kind as keyof typeof labels]}</a></li>;
                })}</ul>}
              </div>)}
            </div>;
          })}
        </nav>
      </details>
      <p class="sidebar-bottom">Máster en Internet de las Cosas</p>
    </aside>
    <div class="site-main">
      <main id="contenido" tabindex="-1">
        <div class="context-bar no-print">
          <button class="button button--secondary button--small sidebar-toggle menu-toggle" type="button" aria-label="Ocultar menú" title="Ocultar menú" aria-controls="menu-principal" aria-expanded="true" hidden><MenuIcon /></button>
          {subject && <><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href={url('/')}>Inicio</a><span aria-hidden="true">/</span><a href={url(`/bimestres/${subject.bimesterId}/`)}>{subject.bimesterId.toUpperCase()}</a><span aria-hidden="true">/</span><a href={resourceUrl(subject, catalog)}>{subject.id === 'protocolos' ? 'Protocolos' : subject.title}</a></nav><a href={subject.teachingGuide.url}>Guía docente <span aria-hidden="true">↗</span></a></>}
        </div>
        <slot />
      </main>
      <footer class="site-footer no-print"><span>Cuaderno IoT · 2026/27</span><a href={url('/')}>Inicio</a></footer>
    </div>
  </body>
</html>
<script>
  const navigation = document.querySelector<HTMLDetailsElement>('.site-navigation');
  const toggle = document.querySelector<HTMLButtonElement>('.sidebar-toggle');
  const preferenceKey = `web-estudio:${import.meta.env.BASE_URL}:sidebar-collapsed`;
  let collapsed = false;
  try { collapsed = localStorage.getItem(preferenceKey) === 'true'; } catch { /* Navigation works without storage. */ }
  const mobile = matchMedia('(max-width: 900px)');
  const update = () => {
    if (navigation) navigation.open = !mobile.matches;
    document.documentElement.toggleAttribute('data-sidebar-collapsed', !mobile.matches && collapsed);
    if (toggle) {
      toggle.hidden = mobile.matches;
      toggle.setAttribute('aria-expanded', String(!collapsed));
      const label = collapsed ? 'Mostrar menú' : 'Ocultar menú';
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    }
  };
  toggle?.addEventListener('click', () => {
    collapsed = !collapsed;
    try { localStorage.setItem(preferenceKey, String(collapsed)); } catch { /* Keep the preference for this page. */ }
    update();
  });
  update();
  mobile.addEventListener('change', update);
</script>
