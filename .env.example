# Solo se utiliza en calendar:sync. Nunca se incorpora al navegador.
# Guarda el enlace de suscripción privado en .env.local (ignorado por Git).
MOOVI_CALENDAR_URL=

# Solo se utiliza en los scripts de generación de audio (TTS de Xiaomi MiMo). Nunca se incorpora al navegador.
MIMO_API_KEY=

# Solo se utiliza en los scripts de generación de audio (TTS vía OpenRouter). Nunca se incorpora al navegador.
OPENROUTER_API_KEY=
