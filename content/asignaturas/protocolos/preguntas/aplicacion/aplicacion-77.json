    }
  ],
  "options": [
    {
      "id": "error-del-cliente",
      "text": "Un error del cliente (4.03).",
      "explanation": "a = 4 es la clase de error del cliente."
    },
    {
      "id": "put",
      "text": "Una petición PUT (0.03).",
      "explanation": "Toma solo los 5 bits bajos; con a = 0 sería PUT, pero aquí a = 4."
    },
    {
      "id": "error-del-servidor",
      "text": "Un error del servidor (5.03).",
      "explanation": "Los 3 bits altos 100 valen 4, no 5."
    },
    {
      "id": "exito",
      "text": "Éxito (2.03).",
      "explanation": "La clase de éxito es a = 2 (bits 010)."
    }
  ],
  "answer": "error-del-cliente"
}
