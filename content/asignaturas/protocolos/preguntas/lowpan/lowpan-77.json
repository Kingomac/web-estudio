    {
      "id": "0x0800",
      "text": "0x0800",
      "explanation": "2 desplazado 10 bits es 2048 = 0x0800; el router lleva Child ID 0."
    },
    {
      "id": "0x0002",
      "text": "0x0002",
      "explanation": "Coloca el Router ID en los bits bajos, que corresponden al Child ID."
    },
    {
      "id": "0x0200",
      "text": "0x0200",
      "explanation": "Desplaza solo 8 bits; el Child ID ocupa 10 bits."
    },
    {
      "id": "0x2000",
      "text": "0x2000",
      "explanation": "Desplaza 12 bits en lugar de 10."
    }
