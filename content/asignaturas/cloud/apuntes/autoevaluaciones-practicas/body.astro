<ul>
<li>
<p>XML</p>
</li>
<li>
<p>YAML</p>
</li>
<li>
<p>HTML</p>
</li>
<li>
<p>JSON</p>
</li>
</ul>
<p><strong>Respuesta publicada:</strong></p><p>JSON</p>
