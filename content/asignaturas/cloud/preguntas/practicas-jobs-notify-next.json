  "type": "single",
  "prompt": "¿Qué notifica el tema reservado `$aws/things/THING/jobs/notify-next`?",
  "explanation": "`notify` avisa cuando se añade o elimina un trabajo de la lista de pendientes; `notify-next`, cuando cambia la primera ejecución pendiente de esa lista.",
  "options": [
    {
      "id": "primera",
      "text": "Que ha cambiado la primera ejecución pendiente de la lista",
      "explanation": "Es la definición de notify-next."
    },
    {
      "id": "lista",
      "text": "Que se ha añadido o eliminado un trabajo de la lista de pendientes",
      "explanation": "Eso lo notifica `jobs/notify`."
    },
    {
      "id": "completed",
      "text": "Que el trabajo ha terminado en todos los destinos",
      "explanation": "Eso es un evento `$aws/events/job/JOB/completed`."
    },
    {
      "id": "tunel",
      "text": "Que hay un túnel seguro abierto para el dispositivo",
      "explanation": "Eso se notifica en `.../tunnels/notify`."
    }
  ],
  "answer": "primera",
