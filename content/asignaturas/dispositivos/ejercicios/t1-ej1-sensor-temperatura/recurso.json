  "fields": [
    {
      "id": "alcance",
      "label": "Alcance S",
      "type": "number",
      "answer": 120,
      "absTol": 0,
      "relTol": 0,
      "unit": "°C",
      "decimalPolicy": "comma-or-point",
      "explanation": "S = Xmax − Xmin = 100 − (−20) = 120 °C. El campo de medida es el intervalo [−20, 100] °C."
    },
    {
      "id": "fso",
      "label": "Fondo de escala de salida",
      "type": "number",
      "answer": 3,
      "absTol": 0,
      "relTol": 0,
      "unit": "V",
      "decimalPolicy": "comma-or-point",
      "explanation": "FSO = Ymax − Ymin = 5 − 2 = 3 V."
    },
    {
      "id": "sens",
      "label": "Sensibilidad",
      "type": "number",
      "answer": 25,
      "absTol": 0,
      "relTol": 0.01,
      "unit": "mV/°C",
      "decimalPolicy": "comma-or-point",
      "explanation": "Recta lineal: 3 V / 120 °C = 0,025 V/°C = 25 mV/°C."
    },
    {
      "id": "exc",
      "label": "Excursión de salida entre 15 y 25 °C",
      "type": "number",
      "answer": 0.25,
      "absTol": 0,
      "relTol": 0.01,
      "unit": "V",
      "decimalPolicy": "comma-or-point",
      "explanation": "V = 2,5 + 0,025·T: 2,875 V a 15 °C y 3,125 V a 25 °C; diferencia 0,25 V."
    },
    {
      "id": "pct",
      "label": "Porcentaje del FSO usado",
      "type": "number",
      "answer": 8.33,
      "absTol": 0,
      "relTol": 0.02,
      "unit": "%",
      "decimalPolicy": "comma-or-point",
      "explanation": "0,25 / 3 = 0,0833 → 8,3 %."
    },
    {
      "id": "adecuado",
      "label": "¿Es adecuado el sensor?",
      "type": "select",
      "options": [
        {
          "id": "si",
          "text": "Sí"
        },
        {
          "id": "no",
          "text": "No"
        }
      ],
      "answer": "no",
      "explanation": "Solo usa el 8,3 % del FSO: la resolución efectiva es pobre. Mejor un sensor de campo más estrecho o amplificar la señal."
    }
