  "prompt": "Una antena transmisora tiene VSWR = 2. ¿Qué fracción de la potencia disponible se entrega a la antena?",
  "explanation": "|Γ| = (2 − 1)/(2 + 1) = 1/3; 1 − |Γ|² = 8/9 ≈ 89 %.",
  "options": [
    {
      "id": "a",
      "text": "8/9 (≈ 89 %)",
      "explanation": "Correcto."
    },
    {
      "id": "b",
      "text": "2/3",
      "explanation": "Es 1 − |Γ|, pero la potencia depende de |Γ|²."
    },
    {
      "id": "c",
      "text": "1/2",
      "explanation": "Confunde VSWR con un divisor de potencia."
    },
    {
      "id": "d",
      "text": "1/9",
      "explanation": "Es la fracción reflejada, |Γ|²."
    }
  ],
  "answer": "a",
